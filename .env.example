# Server
PORT=3000
NODE_ENV=development

# Database (MySQL / MariaDB)
DATABASE_URL="mysql://username:password@localhost:3306/kilatgo_db"

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d
# Access + refresh token (mobile long session)
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production
JWT_ACCESS_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=30d

# Admin default credentials (used by seed)
ADMIN_EMAIL=admin@kilatgo.com
ADMIN_PASSWORD=admin123

# Optional: Payment gateway (mock/configurable)
PAYMENT_GATEWAY=mock

# Optional: Push notification (mock/configurable)
NOTIFICATION_PROVIDER=mock
# URL publik backend — dipakai menyusun tautan reset password di email.
APP_URL=http://localhost:3000

# Pengiriman email reset password lewat Brevo (HTTP API, tanpa dependency npm).
# MAIL_FROM wajib format "Nama <email@domain>"; mailer memisahkannya menjadi
# sender.name + sender.email karena Brevo menolak string gabungan. Domain
# pengirim harus sudah diverifikasi di Brevo (DKIM + Brevo code), kalau tidak
# email ditolak walau kunci API benar. Kunci diawali "xkeysib-".
MAIL_FROM=
BREVO_API_KEY=

# WAJIB di shared hosting ber-CPU banyak (mis. cPanel/CloudLinux 72 core):
# batasi thread tokio Prisma agar tidak menembus limit proses/thread LVE.
# Tanpa ini query DB panic "timer has gone away". 2 aman.
TOKIO_WORKER_THREADS=2

# Origin browser yang boleh memanggil API (dipisah koma). Kosongkan kalau admin
# panel disajikan dari domain yang sama — app mobile tidak butuh entri ini.
CORS_ORIGINS=
